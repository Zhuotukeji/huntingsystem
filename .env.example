# Optional defaults. These can also be encrypted and managed in the settings page.
SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_MODEL=gpt-5.6

# Required in production. Keep stable across restarts or encrypted settings cannot be read.
SETTINGS_ENCRYPTION_KEY=

# Optional initial access code. It can also be configured in the settings page.
PLUGIN_ACCESS_CODE=

# Optional Chrome Web Store detail URL. It can also be configured in the settings page.
CHROME_WEB_STORE_URL=

# Local persistent database.
DATABASE_PATH=.data/hunting.db

# Demo mode creates the default campaign only. It never seeds synthetic companies or people.
DEMO_MODE=true

# The first startup creates one system administrator. Change these values before production deployment.
# The bootstrap account must change its password after the first login.
INITIAL_ADMIN_NAME=系统管理员
INITIAL_ADMIN_EMAIL=admin@hunting.local
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Optional override. Defaults to true in production and false in development.
# Set false only when testing a production build over local HTTP.
AUTH_COOKIE_SECURE=

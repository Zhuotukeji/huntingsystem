# Optional defaults. These can also be encrypted and managed in the settings page.
SUB2API_BASE_URL=
SUB2API_API_KEY=
SUB2API_MODEL=gpt-5.6

# Required in production. Keep stable across restarts or encrypted settings cannot be read.
SETTINGS_ENCRYPTION_KEY=

# Optional initial access code. It can also be configured in the settings page.
PLUGIN_ACCESS_CODE=

# Local persistent database.
DATABASE_PATH=.data/hunting.db

# Demo mode creates the default campaign only. It never seeds synthetic companies or people.
DEMO_MODE=true
